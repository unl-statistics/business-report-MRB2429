library(tibble)
bridge_vars <- tibble(
Variable = c("Bridge Age", "Deck Rating", "Superstructure Rating",
"Substructure Rating", "Sufficiency Rating", "Average Daily Traffic"),
Description = c("Years since the bridge was built",
"Condition of the bridge deck (0-9)",
"Condition of main load-bearing structure",
"Condition of bridge supports",
"Overall bridge condition score (0-100)",
"Vehicles crossing the bridge each day")
)
bridge_vars
